# Kaki database configuration
# Use Render Postgres internal database URL as DATABASE_URL in the service environment.
# Never commit a real URL containing credentials.
DATABASE_URL=postgresql+psycopg://username:password@private-postgres-host:5432/database
KAKI_AUTO_CREATE_SCHEMA=false
KAKI_ALLOW_SINGLE_COMPANY_OAUTH=false
KAKI_ENABLE_MAIL_SYNC=false
KAKI_ENABLE_LEGACY_GRAPH_SYNC=false
DISABLE_SEND=true
# Apply migration explicitly before running the service:
# python -m alembic upgrade head
